# Copy to .env.local (gitignored). Read by `pnpm dev` / `pnpm start` and by the e2e tests.

# HMAC key for the test hooks (/api/test/session, /api/test/reset). Use the same value as the
# Vercel project's Preview environment variable of the same name. Generate: openssl rand -hex 32
# Vercel won't show a sensitive value again, so keep it here; after changing it, redeploy.
INTENZO_HOOK_SECRET=

# Only for running the e2e tests against a protected Vercel preview (BASE_URL=https://…vercel.app):
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
